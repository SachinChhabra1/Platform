# Nia wallet — deploy configuration. Copy to `.env` and fill. NEVER commit `.env`.
# Every value is read from the environment; the app invents no product value.

# --- Postgres (compose provisions this DB) ----------------------------------
POSTGRES_USER=nia
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=nia_wallet

# --- Durable backing --------------------------------------------------------
# 'postgres' for a real deploy; compose also sets DATABASE_URL to the in-network host.
NIA_STORE=postgres
# For bare-metal (no compose), set this to your reachable DB:
# DATABASE_URL=postgres://nia:PASSWORD@localhost:5432/nia_wallet

# --- Service binding --------------------------------------------------------
HOST=0.0.0.0
PORT=8081
SERVICE_NAME=nia-wallet

# --- Ruled / tunable policy config (NOT invented — set by ops) --------------
# Arrears recovery cap: ruled 50% = 5000 bps. 0 disables recovery.
NIA_RECOVERY_CAP_BPS=5000
# Savings T+n settlement horizon in ms. 0 = T+0. (Interest rate is a Founder
# value behind the InterestAccrualPolicy seam; zero-yield until supplied.)
NIA_SAVINGS_SETTLE_MS=0

# --- Service auth (rail webhooks + ops triggers) ----------------------------
# Comma-separated shared secrets. Empty ⇒ rail/ops surfaces deny everything.
NIA_SERVICE_TOKENS=CHANGE-ME-strong-service-token

# --- Founder / ops config files (mounted at /config by compose) -------------
# Floor: ⚠️ the example carries PLACEHOLDER values — replace with Founder-approved
# numbers before any real user (wage settlement refuses to run with no Floor).
NIA_FLOOR_CONFIG_PATH=/config/floor.json
# Operator credentials for conflict resolution (OD-8). Empty file ⇒ deny all.
NIA_OPERATOR_CONFIG_PATH=/config/operators.json
# Member phone directory for login (phone → membershipId). Empty ⇒ login denies all.
NIA_MEMBER_DIRECTORY_CONFIG_PATH=/config/member-directory.json
