# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/ios/Pods/
**/android/.gradle/

# Env & secrets — never commit Member data or credentials
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Deploy: real filled-in config (Floor values, credentials, member phone directory)
# is secret/PII — only the *.example.json templates are tracked.
deploy/config/*.json
!deploy/config/*.example.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
